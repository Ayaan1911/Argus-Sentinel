DATABASE_URL=postgresql+asyncpg://user:password@db:5432/dbname
REDIS_URL=redis://redis:6379/0
SECRET_KEY=your-super-secret-key-here
ENVIRONMENT=production
API_KEY=generate-a-long-random-value-here
ALLOWED_ORIGINS=http://localhost:5173

# Public demo deployment only — see DEMO_DEPLOYMENT.md. Leave DEMO_MODE=false
# (the default) for a normal self-hosted setup; everything below is unused
# unless it's true.
DEMO_MODE=false
DEMO_API_KEY=publicly-documented-demo-key
DEMO_SCAN_DAILY_LIMIT=500
