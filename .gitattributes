# Enforce LF line endings for all text files in the repo
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf

# Python
*.py text eol=lf

# JavaScript / JSX
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
*.mako text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
