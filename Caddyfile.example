# Example for Caddy running on the same host as the Docker Compose stack.
# Replace this name with a domain pointed at that host. Keep the app's
# published API/frontend ports bound to 127.0.0.1 before using this file.
demo.example.com {
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /health {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        reverse_proxy 127.0.0.1:5173
    }
}
