VITE_API_URL=http://localhost:8000/api/v1
VITE_API_KEY=must-match-backend-API_KEY-env-var

# Public demo deployment only — see DEMO_DEPLOYMENT.md. Leave false for a
# normal self-hosted setup. When true, VITE_API_KEY above must match the
# backend's DEMO_API_KEY instead of API_KEY.
VITE_DEMO_MODE=false
